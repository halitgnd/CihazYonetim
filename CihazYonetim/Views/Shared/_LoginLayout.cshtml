<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <link rel="stylesheet" href="~/css/giris.css" asp-append-version="true"/>
    @await RenderSectionAsync("SayfayaOzelIkon", required: false)
    <title>@ViewData["Title"]</title>
</head>
<body>
<header>
    <nav class="navbar-giris">
        <div class="nav_container-giris">
            <img src="~/Resimler/circuit-board.png" alt="Logo" class="navbar-logo-img" />
            <a asp-controller="Home" asp-action="Index" class="logo-giris">
                Cihaz Yönetim Paneli
            </a>
        </div>
    </nav>
</header>
<main>
    @RenderBody()
</main>
<footer>
    
</footer>

<!-- 1. SWEETALERT KÜTÜPHANESİ (Popup'ların çalışması için şart) -->
<script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>