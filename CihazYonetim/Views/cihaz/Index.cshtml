@model IEnumerable<CihazYonetim.Models.Cihazlar>
@{
    ViewData["Title"] = "Simülasyon";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section SayfayaOzelIkon { <link rel="icon" type="image/x-icon" href="~/favicon.png" /> }
@section SayfayaOzelArkaplan { <link rel="stylesheet" href="~/css/back.css" asp-append-version="true"/> }
@section SayfayaOzelCss {
    <link rel="stylesheet" href="~/css/cihazekle.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/simulasyon.css" asp-append-version="true">
}
@section SayfayaOzelAside {
    <link rel="stylesheet" href="~/css/aside.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/lib/fontawesome/all.min.css"/>
    <aside>
        <div class="sidebar">
            <div class="sidebar-ic"><a asp-controller="Dashboard" asp-action="Index" class="sidebar-a"><i class="fa-solid fa-house"></i><p>Ana Sayfa</p></a><hr></div>
            <div class="sidebar-ic"><a asp-controller="Cihaz" asp-action="Index" class="sidebar-a"><i class="fa-solid fa-microchip"></i> <p>Simülasyon</p></a><hr></div>
            @if (User.IsInRole("admin")) {
                <div class="sidebar-ic"><a asp-controller="Kullanicilar" asp-action="Index" class="sidebar-a"><i class="fa-solid fa-users"></i> <p>Kullanıcılar</p></a><hr></div>
            }
            <div class="sidebar-ic"><a asp-controller="Cihazlarliste" asp-action="Index" class="sidebar-a"><i class="fa fa-desktop" aria-hidden="true"></i> <p>Cihazlar</p></a><hr></div>
            <div class="sidebar-ic"><a asp-controller="Raporlar" asp-action="Index" class="sidebar-a"><i class="fa-solid fa-chart-line"></i> <p>Raporlar</p></a><hr></div>
        </div>
    </aside>
}
@if (User.IsInRole("admin"))
{
    <div id="yeniCihazPaneli" class="sim-panel-compact">
        <div class="panel-ust"><i class="fa-solid fa-plus-circle"></i> Yeni Cihaz Tanımla</div>
        <form id="zrhliForm" class="sim-form-row" asp-controller="Cihazlarliste" asp-action="Add" method="post">
            <input type="text" name="CihazName" class="sim-input-focus" placeholder="Cihaz Adı" required>
            <select name="UserId" class="sim-select" required>
                <option value="">Operatör Seç...</option>
                @if (ViewBag.Kullanicilar != null)
                {
                    foreach (var user in ViewBag.Kullanicilar)
                    {
                        <option value="@user.Id">@user.Username</option>
                    }
                }
            </select>
            <select name="Turu" class="sim-select-ozel">
                <option value="0">Router</option>
                <option value="1">Printer</option>
                <option value="2">Computer</option>
            </select>
            <select name="Durum" class="sim-select" required>
                <option value="1">Online</option>
                <option value="0">Offline</option>
                <option value="3">Bakım</option>
                <option value="2">Arıza</option>
            </select>
            <button type="submit" class="btn-sim-submit">KAYDET</button>
        </form>
    </div>
}
<div class="simulasyon-alani" id="simulasyonEkrani">
    
    <svg id="network-cizgileri" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1;"></svg>

    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            string bgRenk = (int)item.Durum == 1 ? "#198754" : 
                            (int)item.Durum == 0 ? "#6c757d" : 
                            (int)item.Durum == 2 ? "#dc3545" : "#fd7e14";  

            string golge = (int)item.Durum == 0 ? "none" : $"0 0 20px {bgRenk}";
                               
            string yazi = (int)item.Durum == 1 ? "Online" :
                          (int)item.Durum == 0 ? "Offline" :
                          (int)item.Durum == 2 ? "Arıza" : "Bakım";

            string ikon = (int)item.Turu == 0 ? "fa-wifi" : 
                          (int)item.Turu == 1 ? "fa-print" : "fa-desktop";

            string pozisyon = (item.PositionX > 0 || item.PositionY > 0) 
                              ? $"left: {item.PositionX}px; top: {item.PositionY}px;" : "";

            <div class="cihaz-daire" data-id="@item.Id" data-durum="@((int)item.Durum)" data-turu="@((int)item.Turu)" style="@pozisyon background-color: @bgRenk; box-shadow: @golge; z-index: 100;">
                <div class="kucuk-daire bakim-btn" title="Bakım">B</div>
                <div class="kucuk-daire ariza-btn" title="Arıza">A</div>
                
                <div class="cihaz-icerik" style="display: flex; flex-direction: column; justify-content: center; align-items: center; width: 100%; height: 100%; cursor: pointer;" title="Durumu değiştirmek için tıkla">
                    <i class="fa-solid @ikon" style="font-size: 28px; margin-bottom: 5px; color: #fff;"></i>
                    <span class="daire-merkez" style="font-size: 13px; font-weight: bold; color: #fff; pointer-events: none;">@yazi</span>
                </div>
                
                <div class="cihaz-isim-etiket">@item.CihazName</div>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="~/js/simulasyon.js" asp-append-version="true"></script>
}