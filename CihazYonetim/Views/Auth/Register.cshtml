@{
    Layout="_LoginLayout";
}
@{
    ViewData["Title"] = "Cihaz Yönetim Kayıt";
}
@section SayfayaOzelIkon {
    <link href="~/add.png" rel="icon" type="image/x-icon" />
}
<div class="login-kapsayici">
    <div class="secim-baslik">
        <h1>Kullanıcı Kaydı</h1>
        <p>Lütfen kayıt bilgilerinizi giriniz.</p>
    </div>
    <form asp-controller="Auth" asp-action="Register" method="post">

        <!-- SADECE KULLANICI ADI VE ŞİFRELER KALDI -->
        <div class="login-ic">
            <input type="text" name="Username" placeholder="Kullanıcı Adı" class="input-alani" required/>
        </div>

        <div class="login-ic">
            <input type="password" name="Password" placeholder="Şifre" class="input-alani" required/>
        </div>

        <div class="login-ic">
            <input type="password" name="ConfirmPassword" placeholder="Şifre Tekrar" class="input-alani" required/>
        </div>

        <div class="alt-secenekler" style="justify-content: center; margin-bottom: 20px;">
            <div class="kayit-kapsayici">
                <a asp-controller="Auth" asp-action="Login" class="kayit-linki">Zaten hesabınız var mı? Giriş Yap</a>
            </div>
        </div>

        <button type="submit" class="login-btn tam-genislik">Kayıt Ol</button>
    </form>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            // 1. DURUM: HATA VARSA (Kullanıcı adı alınmışsa veya şifreler uyuşmuyorsa)
            @if (ViewBag.Hata != null)
            {
                <text>
                Swal.fire({
                    title: 'Hata!',
                    text: '@Html.Raw(ViewBag.Hata)',
                    icon: 'error',
                    confirmButtonText: 'Tamam',
                    confirmButtonColor: '#d33'
                });
                </text>
            }

            // 2. DURUM: BAŞARILIYSA (Kayıt tamamlandıysa)
            @if (ViewBag.Basarili != null)
            {
                <text>
                Swal.fire({
                    title: 'Tebrikler!',
                    text: '@Html.Raw(ViewBag.Basarili)',
                    icon: 'success',
                    confirmButtonText: 'Şimdi Giriş Yap',
                    confirmButtonColor: '#3085d6',
                    allowOutsideClick: false // Boşluğa basınca kapanmasın, illa butona bassın
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Kullanıcıyı JavaScript ile Login sayfasına uçuruyoruz
                        window.location.href = '/Auth/Login';
                    }
                });
                </text>
            }
        });
    </script>
}