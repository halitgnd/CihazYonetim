@model IEnumerable<CihazYonetim.Models.CihazLog>

@{
    Layout = "_LayoutDashboard";
    ViewBag.Title = "Sistem Logları";
}

@section SayfayaOzelIkon {
    <link rel="icon" type="image/x-icon" href="~/document.png" />
}

@section SayfayaOzelCss {
    <link rel="stylesheet" href="~/css/cihazlarliste.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/scroll.css" asp-append-version="true" />
}

<div style="display: flex; flex-direction: column; align-items: center; width: 100%; margin-top: 40px;">
    
    <div style="width: 80%; max-width: 1000px;">
        
        <div style="margin-bottom: 15px;">
            <h3 style="color: #2ecc71; margin: 0; padding-left: 10px; border-left: 4px solid #2ecc71;">Son 50 Sistem Hareketi</h3>
        </div>

        <div class="tablo-kapsayici" style="padding: 0 !important; overflow: hidden !important; border-radius: 8px;">
            
            <div class="ozel-scroll-alani">
                <table class="tablo" style="margin: 0 !important; width: 100%; border-collapse: collapse !important;">
                    <thead style="position: sticky; top: 0; z-index: 10;">
                    <tr>
                        <th style="width: 20%; text-align: center; border-top: none;">Log Tarihi</th>
                        <th style="width: 20%; text-align: center; border-top: none;">İşlem</th>
                        <th style="width: 60%; text-align: left; padding-left: 20px; border-top: none;">Detay / Açıklama</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (Model?.Any() == true)
                    {
                        foreach (var log in Model)
                        {
                            <tr>
                                <td style="text-align: center;"><strong>@log.LogTarihi.ToString("dd.MM.yyyy HH:mm:ss")</strong></td>
                                <td style="text-align: center;">
                                    <span style="background-color: #34495e; padding: 5px 10px; border-radius: 4px; font-size: 13px; font-weight: bold; color: white;">
                                        @log.Islem
                                    </span>
                                </td>
                                <td style="text-align: left; padding-left: 20px; color: #1e272e; font-weight: 500;">
                                    @log.Detay
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="text-align: center; padding: 30px; color: #e74c3c; font-weight: bold;">
                                Sistemde henüz bir log kaydı bulunmuyor.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div style="background-color: #f8f9fa; border-top: 1px solid #ddd; text-align: center; font-weight: bold; padding: 12px; color: #2c3e50; font-size: 14px;">
                Sistem hareketleri tarih sırasına göre listelenmektedir.
            </div>
        </div>
    </div>
</div>